parameters:
    level: 5

    paths:
        - app/Controllers
        - app/Models
        - app/Libraries
        - app/Filters
        - app/Validation
        - app/Cells
        - app/Helpers
        - modules/Backend/Brands/Controllers
        - modules/Backend/Brands/Models
        - modules/Backend/Brands/Libraries
        - modules/Backend/Categories/Controllers
        - modules/Backend/Categories/Models
        - modules/Backend/Categories/Libraries
        - modules/Backend/Products/Controllers
        - modules/Backend/Products/Models
        - modules/Backend/Products/Libraries
        - modules/Backend/Warehouse/Controllers
        - modules/Backend/Warehouse/Models
        - modules/Backend/Warehouse/Libraries

    bootstrapFiles:
        - phpstan-bootstrap.php

    ignoreErrors:
        -
            identifier: codeigniter.modelArgumentInstanceof

    excludePaths:
        analyseAndScan:
            - app/**/_*.php